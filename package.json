{
  "private": true,
  "engines": {
    "node": "26.x",
    "yarn": ">=4.0.0"
  },
  "scripts": {
    "analyze": "cross-env ANALYZE=true next build",
    "analyze:browser": "cross-env BUNDLE_ANALYZE=browser next build",
    "analyze:server": "cross-env BUNDLE_ANALYZE=server next build",
    "analyze:experimental": "next experimental-analyze",
    "analyze:webpack": "cross-env ANALYZE=true next build --webpack",
    "analyze:cli": "node scripts/analyze-bundles-cli.mjs",
    "analyze:api": "node scripts/analyze-bundles-api.mjs",
    "upgrade": "next upgrade",
    "build": "next build",
    "build:development": "NODE_ENV=development env-cmd -f .env.development yarn run prebuild && env-cmd -f .env.development next build",
    "build:production": "NODE_ENV=production env-cmd -f .env.production yarn run prebuild && env-cmd -f .env.production next build",
    "build:staging": "NODE_ENV=staging env-cmd -f .env.staging yarn run prebuild && env-cmd -f .env.staging next build",
    "dev": "next dev",
    "dev:inspect": "next dev --inspect",
    "lint": "eslint .",
    "prebuild": "node scripts/generate-sw.mjs && node scripts/generate-robots.mjs",
    "prepare": "husky",
    "scan": "npx react-scan@latest localhost:3000",
    "i18n:sync": "node scripts/sync-locales.mjs",
    "i18n:labels": "node scripts/generate-locale-labels.mjs",
    "i18n:check": "i18n-check -s ca --locales messages --only invalidKeys,missingKeys",
    "i18n:validate": "node scripts/validate-i18n-placeholders.mjs",
    "lighthouse:ci": "lhci autorun --config=.lighthouserc.json",
    "lighthouse:ci:mobile": "lhci autorun --config=.lighthouserc.mobile.json",
    "start": "next start",
    "start:development": "env-cmd -f .env.development next start",
    "start:production": "NODE_ENV=production env-cmd -f .env.production next start",
    "start:staging": "env-cmd -f .env.staging next start",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:ui": "playwright test --ui",
    "test:watch": "vitest",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ],
    "messages/*.json": [
      "yarn i18n:check",
      "yarn i18n:validate"
    ]
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@fortedigital/nextjs-cache-handler": "^3.4.0",
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@sentry/nextjs": "11.8.0",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "autoprefixer": "^10.6.2",
    "cssnano": "^9.9.0",
    "date-fns": "^4.4.0",
    "fast-xml-parser": "^5.11.2",
    "feed": "^6.0.0",
    "next": "16.4.4",
    "next-intl": "^4.14.9",
    "postcss": "^8.5.32",
    "react": "19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.1",
    "react-select": "^5.10.2",
    "react-share": "^6.1.0",
    "redis": "^6.3.0",
    "sharp": "^0.35.5",
    "swr": "^2.5.1",
    "tailwindcss": "3.3.6",
    "undici": "^8.12.3",
    "web-push": "^3.6.7",
    "web-vitals": "^6.2.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint-react/eslint-plugin": "^5.28.8",
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@lingual/i18n-check": "^0.9.5",
    "@next/bundle-analyzer": "^16.4.4",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/context-async-hooks": "^2.12.0",
    "@opentelemetry/core": "^3.0.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "babel-plugin-react-compiler": "1.0.0",
    "cheerio": "^1.2.0",
    "cross-env": "^10.1.0",
    "env-cmd": "^10.1.0",
    "eslint": "10",
    "eslint-config-next": "^16.4.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.6",
    "husky": "^9.1.7",
    "icu-minify": "^4.14.9",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "next-sitemap": "^4.2.3",
    "typescript": "5.9.3",
    "vite": "^8.3.5",
    "vite-tsconfig-paths": "^4.3.0",
    "vitest": "5.0.5",
    "workbox-broadcast-update": "7.4.1",
    "workbox-cacheable-response": "7.4.1",
    "workbox-core": "7.4.1",
    "workbox-expiration": "7.4.1",
    "workbox-navigation-preload": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1",
    "workbox-sw": "7.4.1"
  },
  "packageManager": "yarn@4.12.0",
  "browserslist": {
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ],
    "production": [
      "chrome >= 122",
      "edge >= 122",
      "firefox >= 125",
      "safari >= 17.4",
      "ios_saf >= 17.4"
    ]
  },
  "resolutions": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  }
}
